<!DOCTYPE html>
<html>

<head>

    <title>Add Candidate</title>

</head>

<body>

    <h1>Add Candidate</h1>

    <form action="/addCandidate" method="POST">

        <input
            type="text"
            name="candidateName"
            placeholder="Candidate Name"
            required
        >

        <br><br>

        <input
            type="text"
            name="partyName"
            placeholder="Party Name"
            required
        >

        <br><br>

        <input
            type="text"
            name="symbol"
            placeholder="Image URL"
            required
        >

        <br><br>

        <button type="submit">
            Add Candidate
        </button>

    </form>

</body>

</html>