<%- include("partials/header") %>

<div class="container mt-5">

    <h2 class="text-center mb-5 fw-bold">
        🗳️ Choose Your Candidate
    </h2>

    <div class="row justify-content-center g-4">

        <% candidates.forEach(candidate => { %>

        <div class="col-md-6 col-lg-3">

            <div class="card shadow h-100 text-center border-0">

                <div class="card-body p-4">

                    <% 
                        let image = "";

                        if (candidate.partyName === "BJP") {
                            image = "/images/bjp.png";
                        } 
                        else if (candidate.partyName === "Congress") {
                            image = "/images/congress.png";
                        } 
                        else if (candidate.partyName === "BRS") {
                            image = "/images/brs.png";
                        } 
                        else if (candidate.partyName === "AIMIM") {
                            image = "/images/aimim.png";
                        }
                    %>

                    <!-- Party Symbol -->
                    <div class="mb-4">

                        <img
                            src="<%= image %>"
                            alt="<%= candidate.partyName %> Symbol"
                            style="
                                width: 180px;
                                height: 150px;
                                object-fit: contain;
                            "
                        >

                    </div>

                    <!-- Candidate Name -->
                    <h3 class="fw-bold mb-2">
                        <%= candidate.candidateName %>
                    </h3>

                    <!-- Party Name -->
                    <h5 class="fw-bold text-secondary mb-4">
                        <%= candidate.partyName %>
                    </h5>

                    <!-- Vote Button -->
                    <form
                        action="/vote/<%= candidate._id %>"
                        method="POST">

                        <button
                            type="submit"
                            class="btn btn-success w-100 fw-bold py-3">

                            🗳️ Vote

                        </button>

                    </form>

                    <!-- Admin Delete -->
                    <% if(user.role === "admin"){ %>

                        <form
                            action="/deleteCandidate/<%= candidate._id %>"
                            method="POST"
                            class="mt-3">

                            <button
                                type="submit"
                                class="btn btn-danger w-100 fw-bold py-2"
                                onclick="return confirm('Delete this candidate?')">

                                🗑️ Delete Candidate

                            </button>

                        </form>

                    <% } %>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</div>

<%- include("partials/footer") %>